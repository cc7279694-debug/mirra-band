<template>
  <div class="page">
    <text class="brand">连接与帮助</text>
    <text class="build-label">{{versionText}}</text>
    <text if="{{showDemo}}" class="badge">{{demoLabel}}</text>
    <list class="connection-list">
      <list-item type="status" class="status-row"><text class="connection-title">{{title}}</text><text class="row-note">{{syncText}}</text></list-item>
      <list-item type="channel" class="info-row"><text class="body-text">{{connectionText}}</text></list-item>
      <list-item type="guidance" class="help-row"><text class="help-text">{{helpText}}</text></list-item>
      <list-item type="lifecycle" class="help-row"><text class="help-text">打开手环应用时更新。息屏或退出后，重新进入会再次获取状态。</text></list-item>
      <list-item type="privacy" class="help-row"><text class="help-text">{{formal ? '手机控制须允许；独立学习在手环操作，结束后确认同步。' : '仅查看当前阅读信息。开始、休息与结束请在手机操作。'}}</text></list-item>
      <list-item if="{{formal}}" type="record-sync" class="help-row"><text class="help-text">{{recordText}}</text></list-item>
      <list-item if="{{errorText}}" type="error" class="help-row"><text class="help-text">诊断代码：{{errorText}}</text></list-item>
      <list-item type="retry" class="control-row"><div class="button" onclick="retry"><text class="button-label">重新连接</text></div></list-item>
      <list-item type="back" class="control-row"><div class="secondary" onclick="back"><text class="secondary-label">返回</text></div></list-item>
    </list>
  </div>
</template>
<script>
import router from '@system.router'
import tickerLib from '../../lib/ticker'
import presentationLib from '../../lib/companion-presentation'
import profile from '../../profile'

export default {
  private: Object.assign(presentationLib.present({}), {
    versionText: 'Mirra ' + profile.versionName + ' / ' + profile.versionCode,
    formal: profile.standalone === true,
    recordText: '完成记录等待协商，原始事实保留。'
  }),
  onInit() {
    this._visible = false
    this._destroyed = false
    this._companion = this.$app.$def.getCompanion()
    this._ticker = tickerLib.createTicker({ refresh: () => this.refresh() })
    this.refresh()
  },
  onShow() {
    if (this._destroyed || this._visible) return
    this._visible = true
    this._off = this._companion.subscribe(() => {
      if (this._visible && !this._destroyed) this.refresh()
    })
    this._companion.start(this)
    this._ticker.show()
  },
  onHide() {
    if (!this._visible) return
    this._visible = false
    if (this._off) this._off()
    this._off = null
    this._ticker.hide()
    this._companion.stop(this)
  },
  onDestroy() {
    this.onHide()
    this._destroyed = true
    if (this._ticker) this._ticker.destroy()
  },
  refresh() {
    if (this._destroyed) return
    const state = this._companion.snapshot()
    const view = presentationLib.present(state)
    Object.keys(view).forEach(key => { this[key] = view[key] })
    const records = state.records
    this.recordText = records && records.errorCode ? '记录未确认：' + records.errorCode
      : records && records.busy ? '正在同步原始记录，等待保存确认。'
      : records && records.confirmedCount > 0 ? '手机原始记录已存；参考时间不计有效专注。'
      : '完成记录等待协商，原始事实保留。'
  },
  retry() { this._companion.requestRefresh() },
  back() { router.back() }
}
</script>
<style>
@import '../../common/theme.css';
.build-label { width: 144px; height: 14px; font-size: 10px; color: #A6B2C3; }
.connection-list { width: 144px; flex: 1; margin-top: 7px; }
.status-row { width: 144px; height: 48px; flex-direction: column; justify-content: center; }
.connection-title { width: 144px; height: 22px; font-size: 13px; color: #EEF3F8; lines: 1; text-overflow: ellipsis; }
.row-note { width: 144px; height: 16px; font-size: 10px; color: #A6B2C3; }
.info-row { width: 144px; height: 28px; align-items: center; }
.help-row { width: 144px; height: 51px; align-items: center; }
.help-text { width: 144px; height: 45px; font-size: 11px; line-height: 15px; lines: 3; text-overflow: ellipsis; color: #A6B2C3; }
.control-row { width: 144px; height: 40px; align-items: center; }
</style>
