<template>
  <div class="page home">
    <text if="{{showDemo}}" class="badge">{{demoLabel}}</text>
    <text class="{{titleClass}}">{{title}}</text>
    <text class="{{canRetry ? 'sync sync-warning' : 'sync'}}">{{syncText}}</text>
    <div class="hero">
      <text if="{{hasTimer}}" class="{{timerClass}}">{{timerText}}</text>
      <text if="{{hasTimer}}" class="timer-label">{{timerLabel}}</text>
      <text if="{{!hasTimer}}" class="hero-text">{{heroText}}</text>
      <text if="{{hint}}" class="hint">{{hint}}</text>
      <text if="{{controlMessage}}" class="control-note">{{controlMessage}}</text>
    </div>
    <div if="{{bookTitle}}" class="book-context">
      <text class="book">{{bookTitle}}</text>
      <text if="{{pageText}}" class="page-number">{{pageText}}</text>
    </div>
    <div class="navigation">
      <div if="{{canRetry}}" class="retry" onclick="retry"><text class="button-label">重试连接</text></div>
      <div if="{{hasControl && !canRetry}}" class="{{controlBusy ? 'control-link control-disabled' : 'control-link'}}" onclick="openControl"><text class="button-label">{{controlLabel}}</text></div>
      <div class="{{canRetry || hasControl ? 'detail-link compact' : 'detail-link'}}" onclick="openDetail"><text class="secondary-label">详情</text></div>
    </div>
  </div>
</template>
<script>
import router from '@system.router'
import tickerLib from '../../lib/ticker'
import presentationLib from '../../lib/companion-presentation'

export default {
  private: presentationLib.present({}),
  onInit() {
    this._visible = false
    this._destroyed = false
    this._companion = this.$app.$def.getCompanion()
    this._ticker = tickerLib.createTicker({ refresh: () => this.refresh() })
    this.refresh()
  },
  onShow() {
    if (this._destroyed || this._visible) return
    this._visible = true
    this._off = this._companion.subscribe(() => {
      if (this._visible && !this._destroyed) this.refresh()
    })
    this._companion.start(this)
    this._ticker.show()
  },
  onRefresh() { this.refresh() },
  onHide() {
    if (!this._visible) return
    this._visible = false
    if (this._off) this._off()
    this._off = null
    this._ticker.hide()
    this._companion.stop(this)
  },
  onDestroy() {
    this.onHide()
    this._destroyed = true
    if (this._ticker) this._ticker.destroy()
  },
  refresh() {
    if (this._destroyed) return
    const view = presentationLib.present(this._companion.snapshot())
    Object.keys(view).forEach(key => { this[key] = view[key] })
  },
  retry() { this._companion.requestRefresh() },
  openControl() {
    if (this._visible && !this._destroyed && !this.showDemo && !this.controlBusy
      && (this.canStartBreak || this.canFinishBreak || this.canConfirmStart)) router.push({ uri: '/pages/Control' })
  },
  openDetail() { router.push({ uri: '/pages/Detail' }) }
}
</script>
<style>
@import '../../common/theme.css';
.state { width: 144px; height: 22px; font-size: 15px; font-weight: bold; color: #EEF3F8; text-align: center; lines: 1; text-overflow: ellipsis; }
.state-small { font-size: 12px; }
.sync { width: 144px; height: 14px; font-size: 10px; color: #A6B2C3; text-align: center; lines: 1; }
.sync-warning { color: #D7B77A; }
.hero { width: 144px; flex: 1; flex-direction: column; justify-content: center; align-items: center; }
.timer { width: 144px; height: 48px; font-size: 40px; color: #6598E8; text-align: center; lines: 1; }
.timer-long { font-size: 26px; }
.timer-label { width: 144px; height: 15px; font-size: 11px; color: #A6B2C3; text-align: center; }
.hero-text { width: 144px; height: 66px; font-size: 16px; line-height: 22px; lines: 3; text-overflow: ellipsis; color: #EEF3F8; text-align: center; }
.hint { width: 144px; height: 16px; font-size: 10px; line-height: 14px; lines: 1; text-overflow: ellipsis; color: #A6B2C3; text-align: center; }
.control-note { width: 144px; height: 30px; font-size: 10px; line-height: 13px; lines: 2; color: #D7B77A; text-align: center; }
.book-context { width: 144px; height: 49px; padding: 3px 8px; border-radius: 9px; background-color: #151C25; flex-direction: column; justify-content: center; }
.book { width: 128px; height: 30px; font-size: 12px; line-height: 15px; lines: 2; text-overflow: ellipsis; color: #EEF3F8; }
.page-number { width: 128px; height: 13px; font-size: 10px; color: #A6B2C3; }
.navigation { width: 144px; height: 32px; margin-top: 8px; flex-direction: row; justify-content: space-between; }
.detail-link { width: 144px; height: 32px; border-radius: 9px; background-color: #151C25; align-items: center; justify-content: center; }
.compact { width: 68px; }
.retry { width: 68px; height: 32px; border-radius: 9px; background-color: #6598E8; align-items: center; justify-content: center; }
.control-link { width: 68px; height: 32px; border-radius: 9px; background-color: #6598E8; align-items: center; justify-content: center; }
.control-disabled { background-color: #314763; }
</style>
