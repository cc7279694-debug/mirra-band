<template>
  <div class="page home">
    <text class="brand">Mirra Band</text>
    <text class="badge">测试模式 · 模拟数据</text>
    <text class="state">{{stateLabel}}</text>
    <text if="{{hasTimer}}" class="timer">{{timerText}}</text>
    <text if="{{hasTimer}}" class="timer-label">{{timerLabel}}</text>
    <text if="{{stateId !== 'idle'}}" class="book">模拟书籍 · {{bookTitle}}</text>
    <text class="message">{{message}}</text>
    <div if="{{canAct}}" class="button action" onclick="act">
      <text class="button-label">{{actionLabel}}</text>
    </div>
    <div if="{{!canAct}}" class="button action" onclick="openStates">
      <text class="button-label">选择测试状态</text>
    </div>
    <div class="navigation">
      <div class="nav-item" onclick="openStates"><text class="nav-label">切换状态</text></div>
      <div class="nav-item" onclick="openConnection"><text class="nav-label">连接信息</text></div>
    </div>
    <text class="footer">未接入手机 Mirra</text>
  </div>
</template>

<script>
import router from '@system.router'
import tickerLib from '../../lib/ticker'

export default {
  private: {
    stateId: 'idle',
    stateLabel: '未开始',
    timerText: '00:00',
    timerLabel: '演示时长',
    bookTitle: '怪诞行为学',
    message: '选择一种状态开始测试',
    actionLabel: '',
    canAct: false,
    hasTimer: false
  },
  onInit() {
    this._ticker = tickerLib.createTicker({
      refresh: () => this.refresh(),
      setInterval: (fn, ms) => setInterval(fn, ms),
      clearInterval: handle => clearInterval(handle)
    })
    this.refresh()
  },
  onShow() {
    this._ticker.show()
  },
  onRefresh() {
    this.refresh()
  },
  onHide() {
    if (this._ticker) this._ticker.hide()
  },
  onDestroy() {
    if (this._ticker) this._ticker.destroy()
  },
  refresh() {
    const view = this.$app.$def.getDemo().snapshot()
    this.stateId = view.stateId
    this.stateLabel = view.stateLabel
    this.timerText = view.timerText
    this.timerLabel = view.timerLabel
    this.bookTitle = view.bookTitle
    this.message = view.message
    this.actionLabel = view.actionLabel
    this.canAct = view.canAct
    this.hasTimer = view.hasTimer
  },
  act() {
    const demo = this.$app.$def.getDemo()
    if (this.stateId === 'preparing') demo.completePreparation()
    else demo.reset()
    this.refresh()
  },
  openStates() {
    router.push({ uri: '/pages/States' })
  },
  openConnection() {
    router.push({ uri: '/pages/Connection' })
  }
}
</script>

<style>
@import '../../common/theme.css';
.home { padding-top: 8px; padding-bottom: 5px; }
.brand { height: 15px; }
.badge { height: 13px; }
.state { width: 144px; height: 22px; margin-top: 4px; font-size: 18px; font-weight: bold; color: #181A1D; text-align: center; }
.timer { width: 144px; height: 32px; font-size: 28px; color: #386FBE; text-align: center; }
.timer-label { width: 144px; height: 12px; font-size: 10px; color: #626873; text-align: center; }
.book { width: 144px; height: 14px; margin-top: 2px; font-size: 11px; color: #181A1D; lines: 1; text-overflow: ellipsis; text-align: center; }
.message { width: 144px; height: 26px; margin-top: 2px; font-size: 11px; line-height: 13px; lines: 2; text-overflow: ellipsis; color: #626873; text-align: center; }
.action { margin-top: 4px; }
.navigation { width: 144px; height: 28px; margin-top: 4px; flex-direction: row; justify-content: space-between; }
.nav-item { width: 70px; height: 28px; border-radius: 7px; background-color: #DCE9FA; justify-content: center; align-items: center; }
.nav-label { font-size: 11px; color: #386FBE; }
.footer { width: 144px; height: 11px; margin-top: 2px; font-size: 9px; color: #626873; text-align: center; }
</style>
