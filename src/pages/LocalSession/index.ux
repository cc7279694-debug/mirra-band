<template>
  <div class="page local-page">
    <!-- VIEW: READY -->
    <div if="{{vm.view === 'READY'}}" class="screen">
      <div class="toolbar"><div class="brand-row"><text class="brand">Mirra</text><text class="badge">{{vm.experimentLabel}}</text></div><div class="light-button" onclick="showDetails"><text class="light-label">详情</text></div></div>
      <div if="{{!vm.preview.isLongAction}}" class="ready-body">
        <div class="ready-book" onclick="showBooks"><text class="book-title">{{vm.preview.bookTitle}}</text><div class="book-meta"><text class="caption book-page" style="width: {{vm.pendingCount > 0 && !vm.notice.visible ? 84 : 144}}px; color: {{vm.notice.visible ? '#E8B75D' : '#A6B2C3'}};">{{vm.notice.visible ? statusLabel : bookPageLabel}}</text><text if="{{vm.pendingCount > 0 && !vm.notice.visible}}" class="record-caption">{{recordLabel}}</text></div></div>
        <div class="first-action-card"><div class="first-action-heading"><text class="first-action-title">先完成这一步</text><div class="light-button" onclick="showActions"><text class="light-label">更换</text></div></div><text class="first-action-text">{{vm.actionText}}</text></div>
        <div class="ready-submit button" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="confirmStart"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.primary.label}}</text></div>
      </div>
      <list if="{{vm.preview.isLongAction}}" class="content-list">
        <list-item type="ready-book" class="long-book-row" onclick="showBooks"><text class="book-title long-book-title">{{vm.preview.bookTitle}}</text><div class="book-meta"><text class="caption book-page" style="width: {{vm.pendingCount > 0 && !vm.notice.visible ? 84 : 144}}px; color: {{vm.notice.visible ? '#E8B75D' : '#A6B2C3'}};">{{vm.notice.visible ? statusLabel : bookPageLabel}}</text><text if="{{vm.pendingCount > 0 && !vm.notice.visible}}" class="record-caption">{{recordLabel}}</text></div></list-item>
        <list-item type="first-label" class="first-action-heading"><text class="first-action-title">先完成这一步</text><div class="light-button" onclick="showActions"><text class="light-label">更换</text></div></list-item>
        <list-item for="{{actionRows}}" type="first-action" class="full-text-row"><text class="full-action-text">{{$item}}</text></list-item>
        <list-item type="confirm-start" class="submit-row"><div class="button" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="confirmStart"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.primary.label}}</text></div></list-item>
      </list>
    </div>
    <!-- VIEW: BOOK_PICKER -->
    <div if="{{vm.view === 'BOOK_PICKER'}}" class="screen">
      <div class="toolbar"><div class="light-button" onclick="backView"><text class="light-label">返回</text></div><text class="toolbar-title">测试书籍</text></div>
      <list class="content-list"><list-item for="{{bookChoices}}" type="book-choice" class="picker-row" style="height: {{$item.height}}px; background-color: {{$item.selected ? '#1D2733' : '#0B0F14'}};" onclick="selectBook($item.id)"><text class="picker-title" style="height: {{$item.titleHeight}}px;">{{$item.title}}</text><div class="picker-meta"><text class="caption">{{$item.startPageText}}</text><text class="selection-mark">{{$item.selected ? '已选' : ''}}</text></div></list-item></list>
    </div>
    <!-- VIEW: ACTION_PICKER -->
    <div if="{{vm.view === 'ACTION_PICKER'}}" class="screen">
      <div class="toolbar"><div class="light-button" onclick="backView"><text class="light-label">返回</text></div><text class="toolbar-title">更换第一步</text></div>
      <list class="content-list"><list-item for="{{actionChoices}}" type="action-choice" class="picker-row" style="height: {{$item.height}}px; background-color: {{$item.selected ? '#1D2733' : '#0B0F14'}};" onclick="selectAction($item.id)"><text class="picker-title" style="height: {{$item.textHeight}}px;">{{$item.text}}</text><text class="selection-caption">{{$item.selected ? '已选 · 仍需完成后确认' : '选择后仍需完成'}}</text></list-item></list>
    </div>
    <!-- VIEW: READING -->
    <div if="{{vm.view === 'READING'}}" class="screen timer-screen">
      <div class="toolbar"><div class="state-heading"><text class="state-title">{{vm.title}}</text><text class="badge">{{vm.experimentLabel}}</text></div><div class="light-button" onclick="showDetails"><text class="light-label">详情</text></div></div>
      <text class="timer-book">{{vm.bookTitle}}</text>
      <div class="timer-hero"><text class="timer-value" style="font-size: {{vm.timer.isLong ? 28 : 40}}px;">{{vm.timer.valueText}}</text><text class="timer-qualifier" style="color: {{vm.timer.isUnknown ? '#E8B75D' : '#A6B2C3'}};">{{vm.timer.label}} · {{vm.timer.qualifier}}</text></div>
      <text class="timer-status" style="color: {{vm.notice.visible ? '#E8B75D' : '#8D9AAE'}};">{{statusLabel}}</text>
      <div class="split-actions"><div class="button split-primary" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="openBreakPicker"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.primary.label}}</text></div><div class="secondary split-secondary" onclick="showFinish"><text class="secondary-label" style="color: {{vm.secondary.enabled ? '#EEF3F8' : '#8D9AAE'}};">{{vm.secondary.label}}</text></div></div>
    </div>
    <!-- VIEW: BREAK_PICKER -->
    <div if="{{vm.view === 'BREAK_PICKER'}}" class="screen">
      <div class="toolbar"><div class="light-button" onclick="backView"><text class="light-label">返回</text></div><text class="toolbar-title">{{vm.title}}</text></div>
      <div class="break-options"><div class="break-option secondary" onclick="beginBreak(5)"><text class="break-option-label" style="color: {{vm.canWrite ? '#EEF3F8' : '#8D9AAE'}};">5 分钟</text></div><div class="break-option secondary" onclick="beginBreak(10)"><text class="break-option-label" style="color: {{vm.canWrite ? '#EEF3F8' : '#8D9AAE'}};">10 分钟</text></div><text class="option-hint">{{vm.busy ? '正在保存…' : '选择后开始休息'}}</text></div>
    </div>
    <!-- VIEW: RESTING -->
    <div if="{{vm.view === 'RESTING'}}" class="screen timer-screen">
      <div class="toolbar"><div class="state-heading"><text class="state-title">{{vm.title}}</text><text class="badge">{{vm.experimentLabel}}</text></div><div class="light-button" onclick="showDetails"><text class="light-label">详情</text></div></div>
      <text class="timer-book">{{vm.bookTitle}}</text>
      <div class="timer-hero"><text class="timer-value" style="font-size: {{vm.timer.valueText === '休息时间已到' ? 16 : (vm.timer.isLong ? 28 : 40)}}px;">{{vm.timer.valueText}}</text><text class="timer-qualifier" style="color: {{vm.timer.isUnknown ? '#E8B75D' : '#A6B2C3'}};">{{vm.timer.label}} · {{vm.timer.qualifier}}</text></div>
      <text class="timer-status" style="color: {{vm.notice.visible ? '#E8B75D' : '#8D9AAE'}};">{{statusLabel}}</text>
      <div class="split-actions"><div class="button split-primary" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="resume"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.primary.label}}</text></div><div class="secondary split-secondary" onclick="showFinish"><text class="secondary-label" style="color: {{vm.secondary.enabled ? '#EEF3F8' : '#8D9AAE'}};">{{vm.secondary.label}}</text></div></div>
    </div>
    <!-- VIEW: FINISH_REVIEW -->
    <div if="{{vm.view === 'FINISH_REVIEW'}}" class="screen">
      <div class="toolbar"><div class="light-button" onclick="backView"><text class="light-label">返回</text></div><text class="toolbar-title">{{vm.title}}</text></div>
      <text class="review-book">{{vm.bookTitle}}</text>
      <div class="review-time"><div class="summary-row"><text class="summary-value">阅读 {{vm.focusTimer.valueText}}</text><text class="summary-qualifier">{{vm.focusTimer.qualifier}}</text></div><div class="summary-row"><text class="summary-value">休息 {{vm.restTimer.valueText}}</text><text class="summary-qualifier">{{vm.restTimer.qualifier}}</text></div></div>
      <div class="page-option" onclick="showPageEditor"><text class="page-option-label">{{vm.endPageText}}</text><text class="page-option-link">补充页码</text></div>
      <text class="confirmation-hint" style="color: {{vm.notice.visible ? '#E8B75D' : '#8D9AAE'}};">{{vm.notice.visible ? statusLabel : '确认后结束'}}</text>
      <div class="button review-submit" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="finishSession"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.primary.label}}</text></div>
    </div>
    <!-- VIEW: PAGE_EDITOR -->
    <div if="{{vm.view === 'PAGE_EDITOR'}}" class="screen editor-screen">
      <div class="editor-toolbar"><div class="light-button" onclick="backView"><text class="light-label">返回</text></div><div class="button compact-save" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="savePage"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.busy ? '保存中' : vm.primary.label}}</text></div></div>
      <text class="page-value">{{vm.pageDigits || '页码：不填写'}}</text>
      <text class="page-error">{{vm.pageError || '正整数 1–999999 · 可以留空'}}</text>
      <div class="key-row"><div class="digit-key" onclick="appendDigit('1')"><text class="key-text">1</text></div><div class="digit-key" onclick="appendDigit('2')"><text class="key-text">2</text></div><div class="digit-key" onclick="appendDigit('3')"><text class="key-text">3</text></div></div>
      <div class="key-row"><div class="digit-key" onclick="appendDigit('4')"><text class="key-text">4</text></div><div class="digit-key" onclick="appendDigit('5')"><text class="key-text">5</text></div><div class="digit-key" onclick="appendDigit('6')"><text class="key-text">6</text></div></div>
      <div class="key-row"><div class="digit-key" onclick="appendDigit('7')"><text class="key-text">7</text></div><div class="digit-key" onclick="appendDigit('8')"><text class="key-text">8</text></div><div class="digit-key" onclick="appendDigit('9')"><text class="key-text">9</text></div></div>
      <div class="key-row"><div class="digit-key" onclick="clearEndPage"><text class="key-text small-key">留空</text></div><div class="digit-key" onclick="appendDigit('0')"><text class="key-text">0</text></div><div class="digit-key" onclick="eraseDigit"><text class="key-text small-key">退格</text></div></div>
    </div>
    <!-- VIEW: SAVED -->
    <div if="{{vm.view === 'SAVED'}}" class="screen">
      <div class="toolbar"><text class="saved-title">{{vm.title}}</text><div class="light-button" onclick="showDetails"><text class="light-label">详情</text></div></div>
      <text class="saved-book">{{vm.bookTitle}}</text>
      <div class="saved-times"><div class="summary-row"><text class="summary-value">阅读 {{vm.focusTimer.valueText}}</text><text class="summary-qualifier">{{vm.focusTimer.qualifier}}</text></div><div class="summary-row"><text class="summary-value">休息 {{vm.restTimer.valueText}}</text><text class="summary-qualifier">{{vm.restTimer.qualifier}}</text></div></div>
      <text class="saved-page">{{vm.endPageText}}</text><text class="saved-source">{{vm.sourceLabel}}</text>
      <text class="saved-notice" style="color: {{vm.notice.visible ? '#E8B75D' : '#8D9AAE'}};">{{vm.notice.visible ? statusLabel : ''}}</text>
      <div class="button saved-submit" onclick="done"><text class="button-label">{{vm.primary.label}}</text></div>
    </div>
    <!-- VIEW: DETAILS -->
    <div if="{{vm.view === 'DETAILS'}}" class="screen">
      <div class="toolbar"><div class="light-button" onclick="backView"><text class="light-label">返回</text></div><text class="toolbar-title">详情 · 实验</text></div>
      <list class="content-list">
        <list-item type="details-scope" class="detail-row"><text class="detail-label">隔离实验 · 测试书籍</text><text class="detail-text">{{vm.details.sourceText}}</text></list-item>
        <list-item type="details-state" class="detail-row"><text class="detail-label">当前状态</text><text class="detail-text">{{vm.details.state}} · {{vm.details.status}}</text></list-item>
        <list-item for="{{bookRows}}" type="details-book" class="full-text-row"><text class="full-action-text">{{$item}}</text></list-item>
        <list-item type="details-first-label" class="detail-label-row"><text class="detail-label">第一步原文</text></list-item>
        <list-item for="{{actionRows}}" type="details-action" class="full-text-row"><text class="full-action-text">{{$item}}</text></list-item>
        <list-item type="details-time" class="detail-tall-row"><text class="detail-label">时间原因</text><text class="detail-text">{{vm.details.timeReasonText}}</text></list-item>
        <list-item if="{{vm.notice.visible}}" type="details-notice" class="detail-tall-row"><text class="warning-title">{{vm.notice.title}}</text><text class="warning-text">{{vm.notice.text}}</text></list-item>
        <list-item type="details-records" class="detail-row"><text class="detail-label">本地记录</text><text class="detail-text">{{vm.details.pendingCount}} 条 · 尚未同步</text></list-item>
        <list-item type="details-sync" class="detail-tall-row"><text class="detail-text">{{vm.details.syncText}}</text></list-item>
        <list-item type="details-version" class="detail-row"><text class="detail-label">实验版本</text><text class="detail-text">{{vm.details.versionText}} · {{vm.details.brandStatus}}</text></list-item>
        <list-item type="details-id" class="detail-tall-row"><text class="detail-label">记录标识 / 序列</text><text class="diagnostic-text">{{vm.details.sessionId || '无活动记录'}} / {{vm.details.sequence}}</text></list-item>
        <list-item type="details-error" class="detail-row"><text class="detail-label">存储 / 操作原因</text><text class="diagnostic-text">{{vm.details.errorCode || '无错误码'}}</text></list-item>
        <list-item for="{{recoveryRows}}" type="details-recovery" class="full-text-row"><text class="warning-text">{{$item}}</text></list-item>
        <list-item type="details-exit" class="submit-row"><div class="secondary" onclick="exitLocal"><text class="secondary-label">退出应用</text></div></list-item>
      </list>
    </div>
    <!-- VIEW: STORAGE_NOTICE -->
    <div if="{{vm.view === 'STORAGE_NOTICE'}}" class="screen">
      <div class="toolbar"><text class="notice-heading">{{vm.notice.title}}</text><div class="light-button" onclick="showDetails"><text class="light-label">详情</text></div></div>
      <list class="notice-list"><list-item for="{{noticeRows}}" type="storage-message" class="notice-text-row"><text class="warning-text">{{$item}}</text></list-item><list-item type="restored-state" class="detail-row"><text class="detail-label">当前恢复状态</text><text class="detail-text">{{vm.state}}</text></list-item><list-item for="{{bookRows}}" type="restored-book" class="full-text-row"><text class="full-action-text">{{$item}}</text></list-item><list-item if="{{vm.bookTitle}}" type="restored-book-name" class="detail-label-row"><text class="caption">{{vm.bookTitle}}</text></list-item></list>
      <div if="{{vm.primary}}" class="button notice-submit" style="background-color: {{vm.primary.enabled ? '#6598E8' : '#1D2733'}};" onclick="noticeAction"><text class="button-label" style="color: {{vm.primary.enabled ? '#0B0F14' : '#A6B2C3'}};">{{vm.primary.label}}</text></div>
    </div>
  </div>
</template>
<script>
import domainLib from '../../lib/local-session'
import presentationLib from '../../lib/local-presentation'
import flowLib from '../../lib/local-ui-flow'
import profile from '../../profile'

export default {
  private: {
    vm: { view: 'STORAGE_NOTICE', state: 'IDLE', bookTitle: '', notice: { title: '正在读取', text: '', visible: true }, primary: { label: '正在读取…', enabled: false } },
    bookRows: [], actionRows: [], noticeRows: [], recoveryRows: [], bookChoices: [], actionChoices: [], statusLabel: '', bookPageLabel: '', recordLabel: ''
  },
  onInit() {
    this._visible = false
    this._destroyed = false
    this._catalog = domainLib.TEST_BOOKS
    this._owner = this.$app.$def.getLocalOwner()
    this._brand = { name: 'Mirra', versionName: profile.versionName, logoAvailable: false, sourceAvailable: false }
    this._flow = flowLib.createLocalUiFlow({ owner: this._owner, catalog: this._catalog, requestExit: () => {
      if (typeof this.$app.exit !== 'function') throw new Error('EXIT_UNAVAILABLE')
      this.$app.exit()
    } })
    this.refresh()
  },
  onShow() {
    if (this._destroyed || this._visible) return Promise.resolve()
    this._visible = true
    this._off = this._flow.subscribe(() => {
      if (this._visible && !this._destroyed) this.refresh()
    })
    this._timer = setInterval(() => {
      // Visible projection only. No dispatch, clock reconstruction or storage IO.
      if (this._visible && !this._destroyed) this.refresh()
    }, 1000)
    return this._flow.show()
  },
  onHide() {
    if (!this._visible) return
    this._visible = false
    if (this._off) this._off()
    this._off = null
    if (this._timer !== undefined) clearInterval(this._timer)
    this._timer = undefined
    this._flow.hide()
  },
  onDestroy() {
    if (this._destroyed) return
    this.onHide()
    this._destroyed = true
    this._flow.dispose()
  },
  onBackPress() {
    if (!this._visible || this._destroyed) return false
    this._flow.back()
    return true
  },
  refresh() {
    if (this._destroyed) return
    const next = presentationLib.presentLocal(this._owner.snapshot(), this._flow.getState(), this._catalog, this._brand)
    // Stable arrays prevent second ticks from rebuilding picker rows or resetting scroll.
    const contentKey = next.bookTitle + '\u0000' + next.actionText + '\u0000' + next.notice.text + '\u0000' + next.details.recoveryText
    if (contentKey !== this._contentKey) {
      this._contentKey = contentKey
      this.bookRows = this.wrapText(next.bookTitle)
      this.actionRows = this.wrapText(next.actionText)
      this.noticeRows = this.wrapText(next.notice.text)
      this.recoveryRows = this.wrapText(next.details.recoveryText)
    }
    const choiceKey = JSON.stringify([next.bookChoices, next.actionChoices])
    if (choiceKey !== this._choiceKey) {
      this._choiceKey = choiceKey
      this.bookChoices = next.bookChoices.map(book => {
        const titleHeight = Math.max(32, Math.ceil(Array.from(book.title).length / 10) * 16)
        return Object.assign({}, book, { titleHeight, height: Math.max(48, titleHeight + 24) })
      })
      this.actionChoices = next.actionChoices.map(action => {
        const textHeight = Math.max(32, Math.ceil(Array.from(action.text).length / 10) * 17)
        return Object.assign({}, action, { textHeight, height: textHeight + 28 })
      })
    }
    this.statusLabel = next.notice.visible ? next.notice.title : next.sourceLabel
    if (next.recoveryNotice.visible && next.notice.title !== next.recoveryNotice.title) {
      const compactNotice = { '记录含不确定区间': '时长待核对', '本地空间预算不足': '容量不足' }
      this.statusLabel = '上一快照 · ' + (compactNotice[next.notice.title] || this.statusLabel)
    }
    this.bookPageLabel = next.preview && next.preview.startPage !== null ? '第' + next.preview.startPage + '页' : '未设置页码'
    this.recordLabel = '本地' + next.pendingCount + '条'
    this.vm = next
  },
  wrapText(value) {
    if (typeof value !== 'string' || !value) return []
    const chars = Array.from(value)
    const rows = []
    for (let offset = 0; offset < chars.length; offset += 18) rows.push(chars.slice(offset, offset + 18).join(''))
    return rows
  },
  showBooks() { return this._flow.openBookPicker() },
  selectBook(bookId) { return this._flow.chooseBook(bookId) },
  showActions() { return this._flow.openActionPicker() },
  selectAction(actionId) { return this._flow.chooseAction(actionId) },
  confirmStart() { return this._flow.confirmStart(this.vm.preview) },
  openBreakPicker() { return this._flow.openBreakPicker() },
  beginBreak(minutes) { return this._flow.beginBreak(minutes) },
  resume() { return this._flow.resume() },
  showFinish() { return this._flow.openFinishReview() },
  showPageEditor() { return this._flow.openPageEditor() },
  appendDigit(value) {
    if (!this._visible || this._destroyed || this.vm.busy || this.vm.view !== 'PAGE_EDITOR' || !/^[0-9]$/.test(value) || this.vm.pageDigits.length >= 6) return
    return this._flow.setPageDigits(this.vm.pageDigits + value)
  },
  eraseDigit() { return this._flow.setPageDigits(this.vm.pageDigits.slice(0, -1)) },
  clearEndPage() { return this._flow.setPageDigits('') },
  finishSession() { return this._flow.finish(null) },
  savePage() { return this._flow.finish() },
  done() { return this._flow.done() },
  backView() { return this._flow.back() },
  showDetails() { return this._flow.openDetails() },
  reload() { return this._flow.reload() },
  noticeAction() {
    if (!this.vm.primary.enabled) return
    if (this.vm.notice.action === 'acknowledgeRecovery') return this._flow.acknowledgeRecovery()
    if (this.vm.notice.action === 'reload') return this._flow.reload()
    return this._flow.exit()
  },
  exitLocal() { return this._flow.exit() }
}
</script>
<style>
@import '../../common/local-theme.css';
</style>
