<template>
  <div class="page local-page">
    <text class="brand">独立学习</text>
    <text class="badge">隔离实验 · 测试书籍</text>
    <list class="local-list">
      <list-item type="scope" class="notice-row"><text class="notice">仅在手环本地执行，实验记录不是手机真实历史。</text></list-item>
      <list-item if="{{!storageQualified}}" type="gate" class="hint-row"><text class="hint">存储尚待真机证明，暂不能开始或保存独立学习。</text></list-item>
      <list-item type="heading" class="heading-row"><text class="heading">{{heading}}</text><text class="caption">{{busy ? '正在保存并核对…' : statusText}}</text></list-item>
      <list-item if="{{errorCode}}" type="error" class="error-row"><text class="error">{{errorCode}}</text></list-item>
      <list-item if="{{recoveryHint}}" type="recovery" class="hint-row"><text class="hint">{{recoveryHint}}</text></list-item>
      <list-item if="{{operationNotice}}" type="unconfirmed-operation" class="hint-row"><text class="hint">{{operationNotice}}</text></list-item>
      <list-item if="{{viewMode === 'home'}}" type="home" class="notice-row"><text class="notice">选择测试书籍，完成具体第一步，再开始独立学习。</text></list-item>
      <list-item if="{{viewMode === 'home'}}" type="select-book" class="action-row"><div class="button" onclick="showBooks"><text class="button-label">选择测试书籍</text></div></list-item>
      <list-item if="{{viewMode === 'books'}}" for="{{bookChoices}}" type="book-choice" class="choice-row" onclick="selectBook($item.id)"><text class="choice-text">{{$item.title}}</text><text class="choice-caption">{{$item.startPageText}}</text></list-item>
      <list-item if="{{viewMode === 'actions'}}" for="{{actionChoices}}" type="action-choice" class="choice-row" onclick="selectAction($item.id)"><text class="choice-text">{{$item.text}}</text><text class="choice-caption">选择动作后仍需实际完成</text></list-item>
      <list-item if="{{bookRows.length > 0 && viewMode !== 'books'}}" type="book-label" class="label-row"><text class="caption">当前测试书籍</text></list-item>
      <list-item if="{{viewMode !== 'books'}}" for="{{bookRows}}" type="book-text" class="text-row"><text class="body-text">{{$item}}</text></list-item>
      <list-item if="{{viewMode === 'prepare'}}" type="first-label" class="label-row"><text class="caption">先实际完成这一小步</text></list-item>
      <list-item if="{{viewMode === 'prepare'}}" for="{{actionRows}}" type="first-text" class="text-row"><text class="body-text">{{$item}}</text></list-item>
      <list-item if="{{viewMode === 'prepare'}}" type="action-select" class="action-row"><div class="secondary" onclick="showActions"><text class="secondary-label">选择第一步动作</text></div></list-item>
      <list-item if="{{viewMode === 'prepare'}}" type="confirm-start" class="action-row"><div class="button" style="background-color: {{canWrite && hasAction ? '#6598E8' : '#151C25'}};" onclick="confirmStart"><text class="button-label" style="color: {{canWrite && hasAction ? '#0B0F14' : '#A6B2C3'}};">我已完成，开始学习</text></div></list-item>
      <list-item if="{{viewMode === 'prepare'}}" type="cancel-prepare" class="action-row"><div class="secondary" onclick="cancelPreparation"><text class="secondary-label">取消本次准备</text></div></list-item>
      <list-item if="{{viewMode === 'focus' || viewMode === 'break' || viewMode === 'finish' || viewMode === 'result'}}" type="focus-time" class="timer-row"><text class="caption">累计学习 · 排除休息</text><text class="timer">{{focusText}}</text></list-item>
      <list-item if="{{viewMode === 'focus' || viewMode === 'break' || viewMode === 'finish' || viewMode === 'result'}}" type="rest-time" class="value-row"><text class="caption">累计休息</text><text class="value">{{restText}}</text></list-item>
      <list-item if="{{timeHint}}" type="time-hint" class="hint-row"><text class="hint">{{timeHint}}</text></list-item>
      <list-item if="{{viewMode === 'focus'}}" type="focus-boundary" class="notice-row"><text class="notice">独立学习未监测。退出、返回表盘或息屏不会自动结束。</text></list-item>
      <list-item if="{{viewMode === 'focus'}}" type="break-five" class="action-row"><div class="button" onclick="beginBreak(5)"><text class="button-label">休息 5 分钟</text></div></list-item>
      <list-item if="{{viewMode === 'focus'}}" type="break-ten" class="action-row"><div class="secondary" onclick="beginBreak(10)"><text class="secondary-label">休息 10 分钟</text></div></list-item>
      <list-item if="{{viewMode === 'break'}}" type="break-left" class="break-row"><text class="break-text">{{breakText}}</text></list-item>
      <list-item if="{{viewMode === 'break'}}" type="resume" class="action-row"><div class="button" onclick="resume"><text class="button-label">继续学习</text></div></list-item>
      <list-item if="{{viewMode === 'focus' || viewMode === 'break'}}" type="finish-open" class="action-row"><div class="secondary" onclick="showFinish"><text class="secondary-label">结束本次学习</text></div></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="finish-notice" class="notice-row"><text class="notice">确认结束后保存本地待同步记录。页码可以留空。</text></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="end-page" class="value-row"><text class="caption">结束页码（可选）</text><text class="value">{{endPageDigits || '未填写 · 不更新进度'}}</text></list-item>
      <list-item if="{{viewMode === 'finish' && pageError}}" type="page-error" class="notice-row"><text class="hint">{{pageError}}</text></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="digits-123" class="key-row"><div class="digit-key" onclick="appendDigit('1')"><text class="key-text">1</text></div><div class="digit-key" onclick="appendDigit('2')"><text class="key-text">2</text></div><div class="digit-key" onclick="appendDigit('3')"><text class="key-text">3</text></div></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="digits-456" class="key-row"><div class="digit-key" onclick="appendDigit('4')"><text class="key-text">4</text></div><div class="digit-key" onclick="appendDigit('5')"><text class="key-text">5</text></div><div class="digit-key" onclick="appendDigit('6')"><text class="key-text">6</text></div></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="digits-789" class="key-row"><div class="digit-key" onclick="appendDigit('7')"><text class="key-text">7</text></div><div class="digit-key" onclick="appendDigit('8')"><text class="key-text">8</text></div><div class="digit-key" onclick="appendDigit('9')"><text class="key-text">9</text></div></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="digits-edit" class="key-row"><div class="digit-key" onclick="clearEndPage"><text class="key-text small-key">留空</text></div><div class="digit-key" onclick="appendDigit('0')"><text class="key-text">0</text></div><div class="digit-key" onclick="eraseDigit"><text class="key-text small-key">退格</text></div></list-item>
      <list-item if="{{viewMode === 'finish'}}" type="finish-confirm" class="action-row"><div class="button" onclick="finishSession"><text class="button-label">确认结束并本地保存</text></div></list-item>
      <list-item if="{{viewMode === 'result'}}" type="result-notice" class="hint-row"><text class="hint">已完成本地读回确认。待同步；本阶段没有手机导入。</text></list-item>
      <list-item if="{{viewMode === 'result'}}" type="new-session" class="action-row"><div class="button" onclick="newSession"><text class="button-label">准备下一次学习</text></div></list-item>
      <list-item type="pending" class="value-row"><text class="caption">本地未同步记录</text><text class="value">{{pendingCount}} 条 · 不自动删除</text></list-item>
      <list-item if="{{sessionId}}" type="session-id" class="identity-row"><text class="caption">当前记录标识</text><text class="identity">{{sessionId}}</text></list-item>
      <list-item if="{{viewMode === 'books' || viewMode === 'actions' || viewMode === 'finish'}}" type="back-view" class="action-row"><div class="secondary" onclick="backView"><text class="secondary-label">返回</text></div></list-item>
      <list-item if="{{status === 'BLOCKED'}}" type="reload" class="action-row"><div class="secondary" onclick="reload"><text class="secondary-label">重新读取并核对</text></div></list-item>
      <list-item if="{{exitNotice}}" type="exit-notice" class="hint-row"><text class="hint">{{exitNotice}}</text></list-item>
      <list-item type="exit" class="action-row"><div class="secondary" onclick="exitLocal"><text class="secondary-label">退出实验应用</text></div></list-item>
    </list>
  </div>
</template>
<script>
import domainLib from '../../lib/local-session'

export default {
  private: {
    state: 'IDLE', status: 'UNOPENED', statusText: '尚未读取', heading: '等待开始', viewMode: 'home',
    busy: false, canWrite: false, storageQualified: false, errorCode: '', recoveryHint: '',
    bookChoices: [], actionChoices: [], bookRows: [], actionRows: [], hasAction: false,
    sessionId: '', pendingCount: 0, focusText: '尚未取得', restText: '尚未取得', breakText: '', timeHint: '',
    endPageDigits: '', pageError: '', exitNotice: '', operationNotice: ''
  },
  onInit() {
    this._visible = false
    this._destroyed = false
    this._actionPending = false
    this._exitRequested = false
    this._operationUncertain = false
    this.bookChoices = domainLib.TEST_BOOKS.map(book => ({
      id: book.id, title: book.title, startPage: book.startPage,
      startPageText: Number.isSafeInteger(book.startPage) && book.startPage > 0
        ? '测试书籍 · 从第 ' + book.startPage + ' 页准备' : '页码未设定，按第一步准备'
    }))
    this._owner = this.$app.$def.getLocalOwner()
    this.refresh()
  },
  onShow() {
    if (this._destroyed || this._visible) return
    this._visible = true
    this._exitRequested = false
    this._off = this._owner.subscribe(() => {
      if (this._visible && !this._destroyed) this.refresh()
    })
    this._timer = setInterval(() => {
      // A visible-only projection; this never advances business state or writes.
      if (this._visible && !this._destroyed) this.refresh()
    }, 1000)
    return this.runAction('open')
  },
  onHide() {
    if (!this._visible) return
    this._visible = false
    if (this._off) this._off()
    this._off = null
    if (this._timer !== undefined) clearInterval(this._timer)
    this._timer = undefined
  },
  onDestroy() {
    if (this._destroyed) return
    this.onHide()
    this._destroyed = true
  },
  onBackPress() {
    if (this.busy) return true
    if (['books', 'actions', 'finish'].indexOf(this.viewMode) !== -1) {
      this.backView()
      return true
    }
    // Returning to the dial does not dispatch FINISH or release the app owner.
    return false
  },
  refresh() {
    if (this._destroyed) return
    const view = this._owner.snapshot()
    const doc = view.document
    const state = doc && doc.state ? doc.state : 'IDLE'
    this.status = view.status || 'UNOPENED'
    this.busy = view.busy === true || this._actionPending === true
    this.storageQualified = view.storageQualified === true
    this.canWrite = this.storageQualified && view.canWrite === true && !this.busy && !this._exitRequested && !this._operationUncertain && this.status !== 'UNCERTAIN' && this.status !== 'CLOSED'
    this.errorCode = view.errorCode || ''
    this.recoveryHint = view.recoveryHint || ''
    this.timeHint = view.timeHint || ''
    this.pendingCount = Number.isSafeInteger(view.pendingCount) && view.pendingCount >= 0 ? view.pendingCount : 0
    const source = doc && (doc.active || doc.preparation || (state === 'FINISHED_PENDING_SYNC' && doc.pending && doc.pending[doc.pending.length - 1]))
    const book = source && source.bookSnapshot
    const action = source && source.firstActionSnapshot
    this.bookRows = this.wrapText(book && book.title)
    this.actionRows = this.wrapText(action && action.text)
    this.hasAction = !!(action && typeof action.id === 'string' && action.id && action.text)
    this.sessionId = doc && doc.active && doc.active.id ? doc.active.id : ''
    const selectedBook = book && domainLib.TEST_BOOKS.find(item => item.id === book.id)
    this.actionChoices = selectedBook ? selectedBook.firstActions : []
    if (this._lastState !== state) this.viewMode = this.modeForState(state)
    this._lastState = state
    this.state = state
    const labels = { IDLE: '等待开始', PREPARING: '第一步准备', FOCUS: '正在独立学习', BREAK: '正在休息', FINISHED_PENDING_SYNC: '本地保存完成' }
    this.heading = labels[state] || '状态待核对'
    const statuses = { UNOPENED: '尚未读取', OPENING: '正在读取', EMPTY: '空槽已核对', READY: '本地快照已核对', RECOVERED: '已恢复有效快照', BLOCKED: '危险写入已停止', UNCERTAIN: '读写结果不确定', CLOSED: '存储已退役', UNQUALIFIED: '等待存储准入' }
    this.statusText = statuses[this.status] || this.status
    const summary = view.summary || {}
    // Finite wall-clock candidates are observations, never verified durations.
    // The domain returns null after rollback, owner change or unverifiable gaps.
    this.focusText = this.durationText(summary.observedFocusMs)
    this.restText = this.durationText(summary.observedBreakMs)
    const remaining = summary.breakRemainingMs
    this.breakText = typeof remaining !== 'number' || !Number.isFinite(remaining) || remaining < 0
      ? '时间不确定，休息仍保留；请主动继续。'
      : (remaining === 0 ? '休息已到时，请主动继续学习。' : '休息观察剩余 ' + this.clockText(remaining))
  },
  wrapText(value) {
    if (typeof value !== 'string' || !value) return []
    const chars = Array.from(value)
    const rows = []
    for (let offset = 0; offset < chars.length; offset += 24) rows.push(chars.slice(offset, offset + 24).join(''))
    return rows
  },
  modeForState(state) {
    const modes = { IDLE: 'home', PREPARING: 'prepare', FOCUS: 'focus', BREAK: 'break', FINISHED_PENDING_SYNC: 'result' }
    return modes[state] || 'home'
  },
  clockText(ms) {
    const seconds = Math.floor(ms / 1000)
    const minutes = Math.floor(seconds / 60)
    const rest = seconds % 60
    return (minutes < 10 ? '0' : '') + minutes + ':' + (rest < 10 ? '0' : '') + rest
  },
  durationText(ms) {
    if (typeof ms !== 'number' || !Number.isFinite(ms) || ms < 0) return '时间不确定'
    return '观察 ' + this.clockText(ms)
  },
  canInteract() {
    return this._visible && !this._destroyed && !this._actionPending && !this.busy && !this._exitRequested && !this._operationUncertain && this.status !== 'UNCERTAIN' && this.status !== 'CLOSED'
  },
  runAction(method, action) {
    if (!this.canInteract() || (method === 'dispatch' && !this.canWrite)) return Promise.resolve()
    this._actionPending = true
    this.refresh()
    const finish = () => {
      this._actionPending = false
      if (this._visible && !this._destroyed) this.refresh()
    }
    const unconfirmed = () => {
      this._operationUncertain = true
      if (this._visible && !this._destroyed) this.operationNotice = '操作结果未确认，请退出并重新打开应用核对；暂不继续写入。'
      finish()
    }
    let operation
    try { operation = method === 'open' ? this._owner.open() : this._owner.dispatch(action) }
    catch (error) { unconfirmed(); return Promise.resolve() }
    return Promise.resolve(operation).then(finish, unconfirmed)
  },
  showBooks() { if (this.canInteract() && this.state === 'IDLE') this.viewMode = 'books' },
  selectBook(bookId) {
    if (this.state !== 'IDLE' || !domainLib.TEST_BOOKS.some(book => book.id === bookId)) return Promise.resolve()
    return this.runAction('dispatch', { type: 'SELECT_BOOK', bookId })
  },
  showActions() { if (this.canInteract() && this.state === 'PREPARING') this.viewMode = 'actions' },
  selectAction(firstActionId) {
    if (this.state !== 'PREPARING' || !this.actionChoices.some(action => action.id === firstActionId)) return Promise.resolve()
    return this.runAction('dispatch', { type: 'SELECT_ACTION', firstActionId }).then(() => {
      if (this._visible && !this._destroyed && this.state === 'PREPARING') this.viewMode = 'prepare'
    })
  },
  confirmStart() {
    if (this.state !== 'PREPARING' || !this.hasAction) return Promise.resolve()
    return this.runAction('dispatch', { type: 'CONFIRM_START', confirmed: true })
  },
  cancelPreparation() {
    if (this.state !== 'PREPARING') return Promise.resolve()
    return this.runAction('dispatch', { type: 'CANCEL_PREPARATION' })
  },
  beginBreak(minutes) {
    if (this.state !== 'FOCUS' || (minutes !== 5 && minutes !== 10)) return Promise.resolve()
    return this.runAction('dispatch', { type: 'BEGIN_BREAK', minutes })
  },
  resume() {
    if (this.state !== 'BREAK') return Promise.resolve()
    return this.runAction('dispatch', { type: 'RESUME' })
  },
  showFinish() {
    if (!this.canInteract() || (this.state !== 'FOCUS' && this.state !== 'BREAK')) return
    this.endPageDigits = ''
    this.pageError = ''
    this.viewMode = 'finish'
  },
  appendDigit(value) {
    if (!this.canInteract() || this.viewMode !== 'finish' || !/^[0-9]$/.test(value) || this.endPageDigits.length >= 6) return
    this.endPageDigits += value
    this.pageError = ''
  },
  eraseDigit() { if (this.canInteract() && this.viewMode === 'finish') { this.endPageDigits = this.endPageDigits.slice(0, -1); this.pageError = '' } },
  clearEndPage() { if (this.canInteract() && this.viewMode === 'finish') { this.endPageDigits = ''; this.pageError = '' } },
  finishSession() {
    if (this.viewMode !== 'finish' || (this.state !== 'FOCUS' && this.state !== 'BREAK')) return Promise.resolve()
    const endPage = this.endPageDigits === '' ? null : Number(this.endPageDigits)
    if (endPage !== null && (!Number.isSafeInteger(endPage) || endPage < 1 || endPage > 999999)) {
      this.pageError = '请填写正整数页码，或点“留空”。'
      return Promise.resolve()
    }
    return this.runAction('dispatch', { type: 'FINISH', endPage })
  },
  newSession() {
    if (this.state !== 'FINISHED_PENDING_SYNC') return Promise.resolve()
    return this.runAction('dispatch', { type: 'NEW_SESSION' })
  },
  backView() { if (this.canInteract()) this.viewMode = this.modeForState(this.state) },
  reload() { return this.runAction('open') },
  exitLocal() {
    if (!this._visible || this._destroyed || this.busy || this._actionPending || this.status === 'CLOSED' || this._exitRequested) return
    if (typeof this.$app.exit !== 'function') { this.exitNotice = '退出接口不可用，请返回表盘；学习记录不会自动结束。'; return }
    this._exitRequested = true
    this.canWrite = false
    this.exitNotice = ''
    try { this.$app.exit() }
    catch (error) { this._exitRequested = false; this.exitNotice = '退出结果未确认，当前学习与记录保留。' }
  }
}
</script>
<style>
@import '../../common/theme.css';
.local-page { padding-top: 8px; padding-bottom: 8px; }
.local-list { width: 144px; flex: 1; margin-top: 5px; }
.notice-row { width: 144px; height: 64px; align-items: center; }
.notice { width: 144px; height: 60px; font-size: 10px; line-height: 16px; lines: 3; color: #A6B2C3; }
.hint-row { width: 144px; height: 100px; align-items: center; }
.hint { width: 144px; height: 96px; font-size: 11px; line-height: 17px; lines: 5; color: #D7B77A; }
.heading-row { width: 144px; height: 52px; flex-direction: column; justify-content: center; }
.heading { width: 144px; height: 26px; font-size: 16px; font-weight: bold; color: #EEF3F8; }
.caption { width: 144px; height: 18px; font-size: 10px; color: #A6B2C3; }
.label-row { width: 144px; height: 26px; align-items: center; }
.text-row { width: 144px; height: 58px; align-items: center; }
.body-text { height: 54px; font-size: 12px; line-height: 18px; lines: 3; }
.choice-row { width: 144px; height: 130px; flex-direction: column; justify-content: center; border-bottom-width: 1px; border-bottom-color: #151C25; }
.choice-text { width: 140px; height: 96px; font-size: 12px; line-height: 18px; lines: 5; color: #EEF3F8; }
.choice-caption { width: 140px; height: 20px; font-size: 10px; color: #6598E8; }
.action-row { width: 144px; height: 46px; align-items: center; }
.button { height: 40px; }
.button-label { width: 132px; height: 20px; font-size: 11px; }
.secondary { height: 40px; }
.secondary-label { width: 132px; height: 20px; font-size: 11px; }
.timer-row { width: 144px; height: 70px; flex-direction: column; justify-content: center; }
.timer { width: 144px; height: 38px; font-size: 22px; font-weight: bold; color: #6598E8; }
.value-row { width: 144px; height: 46px; flex-direction: column; justify-content: center; }
.value { width: 144px; height: 24px; font-size: 12px; color: #EEF3F8; }
.break-row { width: 144px; height: 70px; align-items: center; }
.break-text { width: 144px; height: 64px; font-size: 12px; line-height: 20px; lines: 3; color: #6598E8; }
.key-row { width: 144px; height: 42px; align-items: center; justify-content: space-between; }
.digit-key { width: 44px; height: 36px; border-radius: 8px; background-color: #151C25; align-items: center; justify-content: center; }
.key-text { width: 40px; height: 26px; font-size: 18px; text-align: center; color: #EEF3F8; }
.small-key { font-size: 11px; }
.error-row { width: 144px; height: 50px; align-items: center; }
.error { width: 144px; height: 44px; font-size: 10px; line-height: 15px; lines: 2; color: #D7B77A; }
.identity-row { width: 144px; height: 64px; flex-direction: column; justify-content: center; }
.identity { width: 144px; height: 42px; font-size: 9px; line-height: 14px; lines: 3; color: #A6B2C3; }
</style>
